          "400": { "description": "فایل ارسال نشده، قابل خواندن نبود، یا ستون‌ها قابل تشخیص نبودند", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/campaigns": {
      "get": {
