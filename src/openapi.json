          "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Campaign" } } } } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "summary": "ساخت کمپین جدید (draft)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["productId"],
                "properties": {
                  "name": { "type": "string", "description": "نام دلخواه کمپین (اختیاری)" },
                  "productId": { "type": "string", "description": "شناسه‌ی محصولی که این کمپین برایش ساخته می‌شود" }
                }
              },
              "example": { "name": "کمپین بهاره", "productId": "b1f2c3d4-5678-90ab-cdef-1234567890ab" }
            }
          }
        },
        "responses": {
          "201": { "description": "ساخته شد (در وضعیت draft)", "content": { "application/json": { "schema": { "type": "object", "properties": { "campaign": { "$ref": "#/components/schemas/Campaign" } } } } } },
          "400": { "description": "productId نامعتبر یا متعلق به شما نیست", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
